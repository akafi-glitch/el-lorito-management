# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Never put the secret key in a NEXT_PUBLIC_ variable.

# Project address. Local: printed by `npx supabase start` (usually http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Low-privilege key (starts with sb_publishable_). Safe in the browser; limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Full-access key (starts with sb_secret_). SERVER ONLY.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Time zone used to show dates and times.
APP_TIME_ZONE=America/Chicago

# Receipt paper width in millimetres for the thermal printer: 80 or 58. (Not confirmed yet; 80 is the common size.)
RECEIPT_PAPER_WIDTH_MM=80
